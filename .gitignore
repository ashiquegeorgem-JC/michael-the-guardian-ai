# ------------------------------------------------------------------------------
# MICHAEL - Root .gitignore
# ------------------------------------------------------------------------------

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & coverage
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Databases & local data
*.db
*.sqlite3
data/*.db
data/*.sqlite3

# Node.js & Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Project runtime uploads & temporary reports
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
reports/*
!reports/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

