# ==============================================================================
# MICHAEL - THE GUARDIAN AI Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this directory to configure the backend.
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_SECRET_KEY=replace_with_a_secure_random_secret_in_production

# CORS & Network Boundaries
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Database Architecture
# Options: 'memory' (zero-disk ephemeral), 'sqlite' (local file), 'postgres' (PostgreSQL / Supabase)
PERSISTENCE_BACKEND=memory
DATABASE_URL=sqlite:///./data/michael.db
SQLITE_DB_PATH=./data/michael.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# PostgreSQL / Supabase Direct Connection (Required if PERSISTENCE_BACKEND=postgres)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Supabase Managed Credentials (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Threat Intelligence Provider Configuration
# Options: 'offline_mock' (default air-gapped zero-network), 'virustotal' (live API)
THREAT_INTEL_PROVIDER=offline_mock
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Machine Learning Engine Parameters
MODEL_CONTAMINATION=0.05
TFIDF_MAX_FEATURES=500

# Ingestion & File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Server Binding
HOST=0.0.0.0
PORT=8000
